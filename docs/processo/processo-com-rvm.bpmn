<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://reciclaai.example/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_caixa" name="Caixa do local" processRef="Proc_P_caixa" />
    <bpmn:participant id="P_pessoa" name="Pessoa (app Lixeira Pessoal)" processRef="Proc_P_pessoa" />
    <bpmn:participant id="P_maq" name="Máquina ReciclaAI" processRef="Proc_P_maq" />
    <bpmn:participant id="P_op" name="Operador do local" processRef="Proc_P_op" />
    <bpmn:messageFlow id="MF_1" name="embalagem" sourceRef="p7" targetRef="m0r" />
    <bpmn:messageFlow id="MF_2" name="resultado" sourceRef="m6" targetRef="p8" />
    <bpmn:messageFlow id="MF_3" name="finalizar" sourceRef="p9" targetRef="m7" />
    <bpmn:messageFlow id="MF_4" name="voucher" sourceRef="m8" targetRef="p10" />
    <bpmn:messageFlow id="MF_5" name="voucher" sourceRef="p11" targetRef="c0" />
    <bpmn:messageFlow id="MF_6" name="alerta" sourceRef="m5" targetRef="o0" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_caixa" isExecutable="false">
    <bpmn:startEvent id="c0" name="Voucher apresentado">
      <bpmn:outgoing>SF_39</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c0_med" />
    </bpmn:startEvent>
    <bpmn:task id="c1" name="Ler e validar o voucher">
      <bpmn:incoming>SF_39</bpmn:incoming>
      <bpmn:outgoing>SF_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="cg" name="Voucher válido e ainda não usado?">
      <bpmn:incoming>SF_40</bpmn:incoming>
      <bpmn:outgoing>SF_41</bpmn:outgoing>
      <bpmn:outgoing>SF_43</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c2" name="Resgatar como desconto na compra (uso único)">
      <bpmn:incoming>SF_41</bpmn:incoming>
      <bpmn:outgoing>SF_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ce1" name="Crédito vira venda no local">
      <bpmn:incoming>SF_42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="c3" name="Recusar o voucher">
      <bpmn:incoming>SF_43</bpmn:incoming>
      <bpmn:outgoing>SF_44</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ce2" name="Voucher recusado">
      <bpmn:incoming>SF_44</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_39" sourceRef="c0" targetRef="c1" />
    <bpmn:sequenceFlow id="SF_40" sourceRef="c1" targetRef="cg" />
    <bpmn:sequenceFlow id="SF_41" name="Sim" sourceRef="cg" targetRef="c2" />
    <bpmn:sequenceFlow id="SF_42" sourceRef="c2" targetRef="ce1" />
    <bpmn:sequenceFlow id="SF_43" name="Não" sourceRef="cg" targetRef="c3" />
    <bpmn:sequenceFlow id="SF_44" sourceRef="c3" targetRef="ce2" />
  </bpmn:process>
  <bpmn:process id="Proc_P_pessoa" isExecutable="false">
    <bpmn:startEvent id="p0" name="Quer descartar uma embalagem">
      <bpmn:outgoing>SF_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="p1" name="Fotografar a embalagem no app">
      <bpmn:incoming>SF_1</bpmn:incoming>
      <bpmn:outgoing>SF_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="p2" name="IA identifica o material">
      <bpmn:incoming>SF_2</bpmn:incoming>
      <bpmn:outgoing>SF_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="pg1" name="É resíduo e confiança ≥ 70%?">
      <bpmn:incoming>SF_3</bpmn:incoming>
      <bpmn:outgoing>SF_4</bpmn:outgoing>
      <bpmn:outgoing>SF_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p3" name="Avisar que não reconheceu a embalagem e dar dicas">
      <bpmn:incoming>SF_4</bpmn:incoming>
      <bpmn:outgoing>SF_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="pe1" name="Tentar outra foto">
      <bpmn:incoming>SF_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="pg2" name="Material aceito? (plástico, metal ou vidro)">
      <bpmn:incoming>SF_6</bpmn:incoming>
      <bpmn:outgoing>SF_7</bpmn:outgoing>
      <bpmn:outgoing>SF_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p4" name="Orientar a lixeira certa (azul, marrom ou cinza)">
      <bpmn:incoming>SF_7</bpmn:incoming>
      <bpmn:outgoing>SF_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="pe2" name="Descartado na lixeira certa">
      <bpmn:incoming>SF_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="p5" name="Adicionar à sacola (valor estimado)">
      <bpmn:incoming>SF_9</bpmn:incoming>
      <bpmn:outgoing>SF_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p6" name="Ir ao mercado mais próximo (mapa)">
      <bpmn:incoming>SF_10</bpmn:incoming>
      <bpmn:outgoing>SF_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="p7" name="Inserir a embalagem na máquina">
      <bpmn:incoming>SF_11</bpmn:incoming>
      <bpmn:incoming>SF_14</bpmn:incoming>
      <bpmn:outgoing>SF_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="p8" name="Resultado na tela">
      <bpmn:incoming>SF_12</bpmn:incoming>
      <bpmn:outgoing>SF_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p8_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="pg3" name="Mais embalagens na sacola?">
      <bpmn:incoming>SF_13</bpmn:incoming>
      <bpmn:outgoing>SF_14</bpmn:outgoing>
      <bpmn:outgoing>SF_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="p9" name="Finalizar a sessão">
      <bpmn:incoming>SF_15</bpmn:incoming>
      <bpmn:outgoing>SF_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="p10" name="Voucher impresso">
      <bpmn:incoming>SF_16</bpmn:incoming>
      <bpmn:outgoing>SF_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p10_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="p11" name="Levar o voucher ao caixa">
      <bpmn:incoming>SF_17</bpmn:incoming>
      <bpmn:outgoing>SF_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="pe3" name="Compra com desconto">
      <bpmn:incoming>SF_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_1" sourceRef="p0" targetRef="p1" />
    <bpmn:sequenceFlow id="SF_2" sourceRef="p1" targetRef="p2" />
