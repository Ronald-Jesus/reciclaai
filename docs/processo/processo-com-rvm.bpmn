  <bpmn:process id="Proc_P_op" isExecutable="false">
    <bpmn:startEvent id="o0" name="Painel avisa ≥ 85%">
      <bpmn:outgoing>SF_45</bpmn:outgoing>
      <bpmn:messageEventDefinition id="o0_med" />
    </bpmn:startEvent>
    <bpmn:task id="o1" name="Ir até a máquina">
