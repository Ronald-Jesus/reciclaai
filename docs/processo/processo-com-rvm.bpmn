    <bpmn:sequenceFlow id="SF_15" name="Não" sourceRef="pg3" targetRef="p9" />
    <bpmn:sequenceFlow id="SF_16" sourceRef="p9" targetRef="p10" />
    <bpmn:sequenceFlow id="SF_17" sourceRef="p10" targetRef="p11" />
    <bpmn:sequenceFlow id="SF_18" sourceRef="p11" targetRef="pe3" />
  </bpmn:process>
  <bpmn:process id="Proc_P_maq" isExecutable="false">
    <bpmn:startEvent id="m0" name="Pessoa chega à máquina">
      <bpmn:outgoing>SF_19</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="m0r" name="Receber a embalagem inserida">
      <bpmn:incoming>SF_19</bpmn:incoming>
      <bpmn:incoming>SF_32</bpmn:incoming>
      <bpmn:outgoing>SF_20</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="m1" name="Câmera e IA conferem o material">
      <bpmn:incoming>SF_20</bpmn:incoming>
      <bpmn:outgoing>SF_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="m2" name="Balança confere o peso (*)">
      <bpmn:incoming>SF_21</bpmn:incoming>
      <bpmn:outgoing>SF_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="mg1" name="Aceita? (material válido, confiança ≥ 70%, peso ok)">
      <bpmn:incoming>SF_22</bpmn:incoming>
      <bpmn:outgoing>SF_23</bpmn:outgoing>
      <bpmn:outgoing>SF_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="m3" name="Devolver a embalagem e informar o motivo">
      <bpmn:incoming>SF_23</bpmn:incoming>
      <bpmn:outgoing>SF_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="m4" name="Compactar, separar e somar o valor">
      <bpmn:incoming>SF_24</bpmn:incoming>
      <bpmn:outgoing>SF_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="mg2" name="Compartimento chegou a 85%?">
      <bpmn:incoming>SF_26</bpmn:incoming>
      <bpmn:outgoing>SF_27</bpmn:outgoing>
      <bpmn:outgoing>SF_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="m5" name="Avisar o operador no painel">
      <bpmn:incoming>SF_27</bpmn:incoming>
      <bpmn:outgoing>SF_29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="mm" name="">
      <bpmn:incoming>SF_25</bpmn:incoming>
      <bpmn:incoming>SF_28</bpmn:incoming>
      <bpmn:incoming>SF_29</bpmn:incoming>
      <bpmn:outgoing>SF_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="m6" name="Mostrar o resultado na tela">
      <bpmn:incoming>SF_30</bpmn:incoming>
      <bpmn:outgoing>SF_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="mg3" name="Mais embalagens?">
      <bpmn:incoming>SF_31</bpmn:incoming>
      <bpmn:outgoing>SF_32</bpmn:outgoing>
      <bpmn:outgoing>SF_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="m7" name="Finalizar">
      <bpmn:incoming>SF_33</bpmn:incoming>
      <bpmn:outgoing>SF_34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="m7_med" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="mg4" name="Saldo &gt; 0?">
      <bpmn:incoming>SF_34</bpmn:incoming>
      <bpmn:outgoing>SF_35</bpmn:outgoing>
      <bpmn:outgoing>SF_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="m8" name="Gerar e imprimir o voucher de uso único">
      <bpmn:incoming>SF_35</bpmn:incoming>
      <bpmn:outgoing>SF_36</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="me" name="Sessão encerrada com voucher">
      <bpmn:incoming>SF_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="m9" name="Encerrar sem voucher">
      <bpmn:incoming>SF_37</bpmn:incoming>
      <bpmn:outgoing>SF_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="me2" name="Sessão encerrada sem voucher">
      <bpmn:incoming>SF_38</bpmn:incoming>
    </bpmn:endEvent>
