<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://reciclaai.example/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_atual" name="Descarte de embalagens hoje" processRef="Proc_P_atual" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_atual" isExecutable="false">
    <bpmn:laneSet id="LS_P_atual">
      <bpmn:lane id="L_pessoa" name="Pessoa">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_coleta" name="Coleta municipal">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_coop" name="Cooperativa">
        <bpmn:flowNodeRef>k1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Sente sede">
      <bpmn:outgoing>SF_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Comprar a bebida">
      <bpmn:incoming>SF_1</bpmn:incoming>
      <bpmn:outgoing>SF_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Beber e ficar com a embalagem vazia">
      <bpmn:incoming>SF_2</bpmn:incoming>
      <bpmn:outgoing>SF_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Há lixeira seletiva por perto?">
      <bpmn:incoming>SF_3</bpmn:incoming>
      <bpmn:outgoing>SF_4</bpmn:outgoing>
      <bpmn:outgoing>SF_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="tA" name="Jogar na lixeira seletiva (muitas vezes na cor errada)">
      <bpmn:incoming>SF_4</bpmn:incoming>
      <bpmn:outgoing>SF_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="tB" name="Jogar no lixo comum">
      <bpmn:incoming>SF_5</bpmn:incoming>
      <bpmn:outgoing>SF_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m1" name="">
      <bpmn:incoming>SF_6</bpmn:incoming>
      <bpmn:incoming>SF_7</bpmn:incoming>
      <bpmn:outgoing>SF_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c1" name="Recolher o lixo na rua">
      <bpmn:incoming>SF_8</bpmn:incoming>
      <bpmn:outgoing>SF_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Coleta seletiva sem mistura de lixo?">
      <bpmn:incoming>SF_9</bpmn:incoming>
      <bpmn:outgoing>SF_10</bpmn:outgoing>
      <bpmn:outgoing>SF_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c2" name="Levar tudo ao aterro">
      <bpmn:incoming>SF_11</bpmn:incoming>
      <bpmn:outgoing>SF_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Embalagem enterrada no aterro">
      <bpmn:incoming>SF_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="k1" name="Triar o material à mão">
      <bpmn:incoming>SF_10</bpmn:incoming>
      <bpmn:outgoing>SF_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3" name="Material tem valor?">
      <bpmn:incoming>SF_13</bpmn:incoming>
      <bpmn:outgoing>SF_14</bpmn:outgoing>
      <bpmn:outgoing>SF_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="k2" name="Vender à indústria de reciclagem">
      <bpmn:incoming>SF_14</bpmn:incoming>
      <bpmn:outgoing>SF_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e2" name="Embalagem reciclada">
      <bpmn:incoming>SF_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="k3" name="Descartar o rejeito">
      <bpmn:incoming>SF_16</bpmn:incoming>
      <bpmn:outgoing>SF_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e3" name="Rejeito vai ao aterro">
      <bpmn:incoming>SF_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="SF_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="SF_3" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="SF_4" name="Sim" sourceRef="g1" targetRef="tA" />
    <bpmn:sequenceFlow id="SF_5" name="Não" sourceRef="g1" targetRef="tB" />
    <bpmn:sequenceFlow id="SF_6" sourceRef="tA" targetRef="m1" />
    <bpmn:sequenceFlow id="SF_7" sourceRef="tB" targetRef="m1" />
    <bpmn:sequenceFlow id="SF_8" sourceRef="m1" targetRef="c1" />
    <bpmn:sequenceFlow id="SF_9" sourceRef="c1" targetRef="g2" />
    <bpmn:sequenceFlow id="SF_10" name="Sim" sourceRef="g2" targetRef="k1" />
    <bpmn:sequenceFlow id="SF_11" name="Não" sourceRef="g2" targetRef="c2" />
    <bpmn:sequenceFlow id="SF_12" sourceRef="c2" targetRef="e1" />
    <bpmn:sequenceFlow id="SF_13" sourceRef="k1" targetRef="g3" />
    <bpmn:sequenceFlow id="SF_14" name="Sim" sourceRef="g3" targetRef="k2" />
    <bpmn:sequenceFlow id="SF_15" sourceRef="k2" targetRef="e2" />
    <bpmn:sequenceFlow id="SF_16" name="Não" sourceRef="g3" targetRef="k3" />
    <bpmn:sequenceFlow id="SF_17" sourceRef="k3" targetRef="e3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="P_atual_di" bpmnElement="P_atual" isHorizontal="true"><dc:Bounds x="20" y="20" width="1480" height="630" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_pessoa_di" bpmnElement="L_pessoa" isHorizontal="true"><dc:Bounds x="50" y="20" width="1450" height="180" /></bpmndi:BPMNShape>
