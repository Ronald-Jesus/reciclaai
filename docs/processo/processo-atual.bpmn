      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="92" y="92" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="60" y="132" width="100" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
