      <bpmndi:BPMNShape id="k2_di" bpmnElement="k2"><dc:Bounds x="1180" y="430" width="100" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1352" y="442" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1320" y="482" width="100" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
